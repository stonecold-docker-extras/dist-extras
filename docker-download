#!/bin/sh

while [ ${#} -gt 0 ]
do
	case "${1}" in
		goreman)
			URL=""
			if [ -e /lib/ld-musl-x86_64.so.1 ]; then
				URL=https://github.com/stonecold-docker-extras/dist-extras/raw/refs/heads/main/goreman-musl-x64
			elif [ -e /lib/ld-musl-aarch64.so.1 ]; then
				URL=https://github.com/stonecold-docker-extras/dist-extras/raw/refs/heads/main/goreman-musl-aarch64
			elif [ -e /lib/ld-musl-armhf.so.1 ]; then
				URL=https://github.com/stonecold-docker-extras/dist-extras/raw/refs/heads/main/goreman-musl-armv7h
			elif [ -e /lib64/ld-linux-x86-64.so.2 ]; then
				URL=https://github.com/stonecold-docker-extras/dist-extras/raw/refs/heads/main/goreman-glibc-x64
			elif [ -e /lib/ld-linux-aarch64.so.1 ]; then
				URL=https://github.com/stonecold-docker-extras/dist-extras/raw/refs/heads/main/goreman-glibc-aarch64
			elif [ -e /lib/ld-linux-armhf.so.3 ]; then
				URL=https://github.com/stonecold-docker-extras/dist-extras/raw/refs/heads/main/goreman-glibc-armv7h
			fi
			wget --no-check-certificate "${URL}" -O /usr/local/bin/goreman
			chmod 755 /usr/local/bin/goreman
			;;
		gosu)
			URL=""
			if [ -e /lib/ld-musl-x86_64.so.1 -o -e /lib64/ld-linux-x86-64.so.2 ]; then
				URL=https://github.com/stonecold-docker-extras/dist-extras/raw/refs/heads/main/gosu-amd64
			elif [ -e /lib/ld-musl-aarch64.so.1 -o -e /lib/ld-linux-aarch64.so.1 ]; then
				URL=https://github.com/stonecold-docker-extras/dist-extras/raw/refs/heads/main/gosu-arm64
			elif [ -e /lib/ld-musl-armhf.so.1 -o -e /lib/ld-linux-armhf.so.3 ]; then
				URL=https://github.com/stonecold-docker-extras/dist-extras/raw/refs/heads/main/gosu-armhf
			fi
			wget --no-check-certificate "${URL}" -O /usr/local/bin/gosu
			chmod 755 /usr/local/bin/gosu
			;;
		su-exec)
			URL=""
			if [ -e /lib/ld-musl-x86_64.so.1 ]; then
				URL=https://github.com/stonecold-docker-extras/dist-extras/raw/refs/heads/main/su-exec-musl-x64
			elif [ -e /lib/ld-musl-aarch64.so.1 ]; then
				URL=https://github.com/stonecold-docker-extras/dist-extras/raw/refs/heads/main/su-exec-musl-aarch64
			elif [ -e /lib/ld-musl-armhf.so.1 ]; then
				URL=https://github.com/stonecold-docker-extras/dist-extras/raw/refs/heads/main/su-exec-musl-armv7h
			elif [ -e /lib64/ld-linux-x86-64.so.2 ]; then
				URL=https://github.com/stonecold-docker-extras/dist-extras/raw/refs/heads/main/su-exec-glibc-x64
			elif [ -e /lib/ld-linux-aarch64.so.1 ]; then
				URL=https://github.com/stonecold-docker-extras/dist-extras/raw/refs/heads/main/su-exec-glibc-aarch64
			elif [ -e /lib/ld-linux-armhf.so.3 ]; then
				URL=https://github.com/stonecold-docker-extras/dist-extras/raw/refs/heads/main/su-exec-glibc-armv7h
			fi
			wget --no-check-certificate "${URL}" -O /usr/local/bin/su-exec
			chmod 755 /usr/local/bin/su-exec
			;;
	   	*) 
			echo "Unknown tool : ${1}"
			;;
	esac
	shift
done
