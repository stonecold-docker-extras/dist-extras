#!/usr/bin/env bash

LC_ALL=C 

apt-get() {
	#DEBIAN_FRONTEND=noninteractive DEBCONF_NONINTERACTIVE_SEEN=true /usr/bin/apt-get -y $(grep '^deb [^ ]* [^ ]*-[^ ]* .*$' /etc/apt/sources.list | sed 's/^deb [^ ]* \([^ ]*-[^ ]*\) .*$/-t \1/g') "${@}"
	DEBIAN_FRONTEND=noninteractive DEBCONF_NONINTERACTIVE_SEEN=true /usr/bin/apt-get -y "${@}"
}

fn_usage() {
	echo "Usage : $(basename "${0}") [package]"
	exit 1
}

fn_refresh() {
	apt-get update ${@}
}

fn_update() {
	apt-get dist-upgrade ${@}
}

fn_install() {
	apt-get install ${@}
}

fn_delete() {
	apt-get autoremove ${@} --purge -y
}

fn_install_custom() {
	if [ "${PACKAGE_GOREMAN}" = "Y" ]; then
		local URL=""
		if [ -e /lib/ld-musl-x86_64.so.1 ]; then
			URL=https://bitbucket.org/forumi0721/docker-dist-extras/raw/master/goreman-musl-x64
		elif [ -e /lib/ld-musl-aarch64.so.1 ]; then
			URL=https://bitbucket.org/forumi0721/docker-dist-extras/raw/master/goreman-musl-aarch64
		elif [ -e /lib/ld-musl-armhf.so.1 ]; then
			URL=https://bitbucket.org/forumi0721/docker-dist-extras/raw/master/goreman-musl-armv7h
		elif [ -e /lib64/ld-linux-x86-64.so.2 ]; then
			URL=https://bitbucket.org/forumi0721/docker-dist-extras/raw/master/goreman-glibc-x64
		elif [ -e /lib/ld-linux-aarch64.so.1 ]; then
			URL=https://bitbucket.org/forumi0721/docker-dist-extras/raw/master/goreman-glibc-aarch64
		elif [ -e /lib/ld-linux-armhf.so.3 ]; then
			URL=https://bitbucket.org/forumi0721/docker-dist-extras/raw/master/goreman-glibc-armv7h
		fi
		wget --no-check-certificate "${URL}" -o /usr/local/bin/goreman
		chmod 755 /usr/local/bin/goreman
	fi
	if [ "${PACKAGE_GOSU}" = "Y" ]; then
		local URL=""
		if [ -e /lib/ld-musl-x86_64.so.1 -o -e /lib64/ld-linux-x86-64.so.2 ]; then
			URL=https://bitbucket.org/forumi0721/docker-dist-extras/raw/master/gosu-amd64
		elif [ -e /lib/ld-musl-aarch64.so.1 -o -e /lib/ld-linux-aarch64.so.1 ]; then
			URL=https://bitbucket.org/forumi0721/docker-dist-extras/raw/master/gosu-arm64
		elif [ -e /lib/ld-musl-armhf.so.1 -o -e /lib/ld-linux-armhf.so.3 ]; then
			URL=https://bitbucket.org/forumi0721/docker-dist-extras/raw/master/gosu-armhf
		fi
		wget --no-check-certificate "${URL}" -o /usr/local/bin/gosu
		chmod 755 /usr/local/bin/gosu
	fi
	if [ "${PACKAGE_SUEXEC}" = "Y" ]; then
		local URL=""
		if [ -e /lib/ld-musl-x86_64.so.1 ]; then
			URL=https://bitbucket.org/forumi0721/docker-dist-extras/raw/master/su-exec-musl-x64
		elif [ -e /lib/ld-musl-aarch64.so.1 ]; then
			URL=https://bitbucket.org/forumi0721/docker-dist-extras/raw/master/su-exec-musl-aarch64
		elif [ -e /lib/ld-musl-armhf.so.1 ]; then
			URL=https://bitbucket.org/forumi0721/docker-dist-extras/raw/master/su-exec-musl-armv7h
		elif [ -e /lib64/ld-linux-x86-64.so.2 ]; then
			URL=https://bitbucket.org/forumi0721/docker-dist-extras/raw/master/su-exec-glibc-x64
		elif [ -e /lib/ld-linux-aarch64.so.1 ]; then
			URL=https://bitbucket.org/forumi0721/docker-dist-extras/raw/master/su-exec-glibc-aarch64
		elif [ -e /lib/ld-linux-armhf.so.3 ]; then
			URL=https://bitbucket.org/forumi0721/docker-dist-extras/raw/master/su-exec-glibc-armv7h
		fi
		wget --no-check-certificate "${URL}" -o /usr/local/bin/su-exec
		chmod 755 /usr/local/bin/su-exec
	fi
}

fn_delete_custom() {
	if [ "${PACKAGE_GOREMAN}" = "Y" ]; then
		rm -rf /usr/local/bin/goreman
	fi
	if [ "${PACKAGE_GOSU}" = "Y" ]; then
		rm -rf /usr/local/bin/gosu
	fi
	if [ "${PACKAGE_SUEXEC}" = "Y" ]; then
		rm -rf /usr/local/bin/su-exec
	fi
}

fn_clean() {
	apt-get autoremove --purge
	apt-get clean
	find /var/lib/apt -type f -exec rm "{}" \;
	rm -rf /qemu_sh_*.core
}


#Main
if [ -z "${1}" ]; then
	fn_usage
fi

if [ "$(id -u)" != "0" ]; then
	echo "root privileges are required"
	exit 1
fi

PARAM_REFRESH=N
PARAM_UPDATE=N
PARAM_DEL=N
PARAM_CLEAN=N
PARAM_EXTRA=()
PACKAGES=()
PACKAGE_GOREMAN=N
PACKAGE_GOSU=N
PACKAGE_SUEXEC=N

while [[ ${#} > 0 ]]
do
	case "${1}" in
		-h|--help) fn_usage ;;
		-r|--refresh) PARAM_REFRESH=Y ;;
		-u|--update) PARAM_UPDATE=Y ;;
		-d|--del) PARAM_DEL=Y ;;
		-c|--cean) PARAM_CLEAN=Y ;;
		-o) PARAM_EXTRA+=(${1} ${2}) ; shift ;;
		goreman) PACKAGE_GOREMAN=Y ;;
		gosu) PACKAGE_GOSU=Y ;;
		su-exec) PACKAGE_SUEXEC=Y ;;
		*) PACKAGES+=(${1}) ;;
	esac
	shift
done

if [ "${PARAM_REFRESH}" = "Y" ]; then
	fn_refresh ${PARAM_EXTRA[@]}
elif [ "${PARAM_UPDATE}" = "Y" ]; then
	fn_refresh ${PARAM_EXTRA[@]}
elif [ ! -z "${PACKAGES}" -a -z "$(ls /var/lib/apt/lists/* 2> /dev/null)" ]; then
	fn_refresh ${PARAM_EXTRA[@]}
fi

if [ "${PARAM_UPDATE}" = "Y" ]; then
	fn_update ${PARAM_EXTRA[@]}
fi

if [ ! -z "${PACKAGES}" ]; then
	if [ "${PARAM_DEL}" = "N" ]; then
		fn_install ${PARAM_EXTRA[@]} ${PACKAGES[@]}
	else
		fn_delete ${PARAM_EXTRA[@]} ${PACKAGES[@]}
	fi
fi
if [ "${PARAM_DEL}" = "N" ]; then
	fn_install_custom
else
	fn_delete_custom
fi

if [ "${PARAM_CLEAN}" = "Y" ]; then
	fn_clean
fi

